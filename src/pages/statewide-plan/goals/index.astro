---
/**
 * Statewide Plan - Goals Overview
 * Displays all 4 goals with statistics
 */

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import GoalCard from '../../../components/statewide-plan/GoalCard.astro';
import { getAllGoals } from '../../../utils/statewide-plan.js';

const goals = getAllGoals();
---

<DashboardLayout>
  <!-- Main Content Area -->
  <div class="px-6 py-4">
    <div>
      <!-- Page Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
          Nebraska Statewide Plan for Community Well-Being
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Explore the four core goals driving Nebraska's community well-being initiatives
        </p>
      </div>

      <!-- Navigation Pills -->
      <div class="mb-6 border-b border-gray-200 dark:border-gray-700">
        <ul class="flex flex-wrap -mb-px text-sm font-medium text-center">
          <li class="mr-2">
            <a href="/statewide-plan/goals" class="inline-block p-4 text-blue-600 border-b-2 border-blue-600 rounded-t-lg active dark:text-blue-500 dark:border-blue-500">
              Goals
            </a>
          </li>
          <li class="mr-2">
            <a href="/statewide-plan/objectives" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
              Objectives
            </a>
          </li>
          <li class="mr-2">
            <a href="/statewide-plan/strategies" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
              Strategies
            </a>
          </li>
          <li class="mr-2">
            <a href="/statewide-plan/action-steps" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
              Action Steps
            </a>
          </li>
          <li class="mr-2">
            <a href="/statewide-plan/commitments" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
              Commitments
            </a>
          </li>
        </ul>
      </div>

      <!-- Goals Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {goals.map(goal => (
          <GoalCard goal={goal} />
        ))}
      </div>

      <!-- About Section -->
      <div class="mt-8 p-6 bg-blue-50 dark:bg-gray-800 rounded-lg border border-blue-200 dark:border-gray-700">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
          About the Statewide Plan
        </h2>
        <p class="text-gray-700 dark:text-gray-300 mb-2">
          The Nebraska Statewide Plan for Community Well-Being represents a collaborative effort to
          improve outcomes for children, youth, families, and communities across the state.
        </p>
        <p class="text-gray-700 dark:text-gray-300">
          Each goal contains objectives, strategies, and specific action steps driven by Nebraska
          Children staff, Community Collaboratives, and System Partners.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // Flowbite initialization
  import 'flowbite';
</script>
