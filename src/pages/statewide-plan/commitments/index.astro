---
/**
 * All Commitments View
 * Displays system partner commitments (2 records) with comprehensive filtering
 * Following the pattern established in action-steps/index.astro
 */

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import {
  getAllCommitments,
  getAllGoals,
  getAllObjectives,
  getAllStrategies,
  getGoalById,
  getObjectiveById,
  getStrategyById,
  formatCompletionDate,
  getUniqueStatuses,
  getUniqueYears,
  getUniqueQuarters
} from '../../../utils/statewide-plan.js';

const commitments = getAllCommitments();
const goals = getAllGoals();
const objectives = getAllObjectives();
const strategies = getAllStrategies();
const statuses = getUniqueStatuses('commitments');
const years = getUniqueYears('commitments');
const quarters = getUniqueQuarters('commitments');
---

<DashboardLayout>
  <div class="px-6 py-4">
    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
        All Commitments
      </h1>
      <p class="text-gray-600 dark:text-gray-400">
        Browse and filter all {commitments.length} system partner commitments
      </p>
    </div>

    <!-- Navigation Pills -->
    <div class="mb-6 border-b border-gray-200 dark:border-gray-700">
      <ul class="flex flex-wrap -mb-px text-sm font-medium text-center">
        <li class="mr-2">
          <a href="/statewide-plan/goals" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
            Goals
          </a>
        </li>
        <li class="mr-2">
          <a href="/statewide-plan/objectives" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
            Objectives
          </a>
        </li>
        <li class="mr-2">
          <a href="/statewide-plan/strategies" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
            Strategies
          </a>
        </li>
        <li class="mr-2">
          <a href="/statewide-plan/action-steps" class="inline-block p-4 border-b-2 border-transparent rounded-t-lg text-gray-500 hover:text-gray-600 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300">
            Action Steps
          </a>
        </li>
        <li class="mr-2">
          <a href="/statewide-plan/commitments" class="inline-block p-4 text-blue-600 border-b-2 border-blue-600 rounded-t-lg active dark:text-blue-500 dark:border-blue-500">
            Commitments
          </a>
        </li>
      </ul>
    </div>

    <!-- Filters Section -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
          Filter Commitments
        </h2>
        <button
          type="button"
          id="clearFilters"
          class="text-sm text-blue-700 hover:text-blue-800 dark:text-blue-500 dark:hover:text-blue-400 font-medium"
        >
          Clear All Filters
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Search by Name/Details -->
        <div class="lg:col-span-2">
          <label for="searchInput" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            Search by Name or Details
          </label>
          <input
            type="text"
            id="searchInput"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            placeholder="Search commitments..."
          />
        </div>

        <!-- Filter by Goal -->
        <div>
          <label for="goalFilter" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            Filter by Goal
          </label>
          <select
            id="goalFilter"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          >
            <option value="">All Goals</option>
            {goals.map(goal => (
              <option value={goal.goal_id}>
                Goal {goal.goal_number}
              </option>
            ))}
          </select>
        </div>

        <!-- Filter by Objective -->
        <div>
          <label for="objectiveFilter" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            Filter by Objective
          </label>
          <select
            id="objectiveFilter"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          >
            <option value="">All Objectives</option>
            {objectives.map(objective => (
              <option value={objective.objective_id} data-goal-id={objective.related_goal_id}>
                Obj {objective.objective_number}
              </option>
            ))}
          </select>
        </div>

        <!-- Filter by Strategy -->
        <div class="lg:col-span-2">
          <label for="strategyFilter" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            Filter by Strategy
          </label>
          <select
            id="strategyFilter"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          >
            <option value="">All Strategies</option>
            {strategies.map(strategy => (
              <option value={strategy.strategy_id} data-objective-id={strategy.related_objective_id} data-goal-id={strategy.related_goal_id}>
                {strategy.strategy_number}
              </option>
            ))}
          </select>
        </div>

        <!-- Filter by Status -->
        <div>
          <label for="statusFilter" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            Status
          </label>
          <select
            id="statusFilter"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          >
            <option value="">All Statuses</option>
            {statuses.map(status => (
              <option value={status}>{status}</option>
            ))}
          </select>
        </div>

        <!-- Filter by Year -->
        <div>
          <label for="yearFilter" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            Completion Year
          </label>
          <select
            id="yearFilter"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          >
            <option value="">All Years</option>
            {years.map(year => (
              <option value={year}>{year}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Results Count -->
      <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Showing <strong id="totalResults" class="text-gray-900 dark:text-white">{commitments.length}</strong> commitment{commitments.length !== 1 ? 's' : ''}
        </p>
      </div>
    </div>

    <!-- Commitments Table -->
    <div id="commitmentsTableContainer" class="relative overflow-x-auto shadow-md sm:rounded-lg bg-white dark:bg-gray-800">
      <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
          <tr>
            <th scope="col" class="px-6 py-3">Commitment Number</th>
            <th scope="col" class="px-6 py-3">Commitment Name</th>
            <th scope="col" class="px-4 py-3">Strategy</th>
            <th scope="col" class="px-4 py-3">Objective</th>
            <th scope="col" class="px-4 py-3">Goal</th>
            <th scope="col" class="px-4 py-3">Partner/Lead</th>
            <th scope="col" class="px-4 py-3">Status</th>
            <th scope="col" class="px-4 py-3">Due</th>
            <th scope="col" class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody id="commitmentsTableBody">
          <!-- Populated by JavaScript -->
        </tbody>
      </table>
    </div>

    <!-- No Results Message -->
    <div id="noResults" class="hidden text-center py-12 bg-white dark:bg-gray-800 rounded-lg shadow-md">
      <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-white">No commitments found</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Try adjusting your filters or search term.</p>
      <div class="mt-6">
        <button
          type="button"
          id="noResultsClear"
          class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
        >
          Clear all filters
        </button>
      </div>
    </div>
  </div>

  <script>
    import { formatCompletionDate } from '../../../utils/statewide-plan.js';

    // Serialize data from server-side
    const allCommitments = JSON.parse(document.getElementById('commitmentsData')?.textContent || '[]');
    const goalsMap = JSON.parse(document.getElementById('goalsData')?.textContent || '{}');
    const objectivesMap = JSON.parse(document.getElementById('objectivesData')?.textContent || '{}');
    const strategiesMap = JSON.parse(document.getElementById('strategiesData')?.textContent || '{}');

    let filteredCommitments = [...allCommitments];

    document.addEventListener('DOMContentLoaded', () => {
      // Initialize event listeners
      document.getElementById('searchInput')?.addEventListener('input', applyFiltersAndRender);
      document.getElementById('goalFilter')?.addEventListener('change', handleGoalChange);
      document.getElementById('objectiveFilter')?.addEventListener('change', handleObjectiveChange);
      document.getElementById('strategyFilter')?.addEventListener('change', applyFiltersAndRender);
      document.getElementById('statusFilter')?.addEventListener('change', applyFiltersAndRender);
      document.getElementById('yearFilter')?.addEventListener('change', applyFiltersAndRender);
      document.getElementById('clearFilters')?.addEventListener('click', resetFilters);
      document.getElementById('noResultsClear')?.addEventListener('click', resetFilters);

      // Initial render
      applyFiltersAndRender();
    });

    function handleGoalChange() {
      const goalFilter = document.getElementById('goalFilter') as HTMLSelectElement;
      const objectiveFilter = document.getElementById('objectiveFilter') as HTMLSelectElement;
      const strategyFilter = document.getElementById('strategyFilter') as HTMLSelectElement;
      const selectedGoalId = goalFilter?.value;

      // Update objective dropdown
      updateCascadingDropdown(objectiveFilter, 'data-goal-id', selectedGoalId);

      // Update strategy dropdown based on goal
      updateCascadingDropdown(strategyFilter, 'data-goal-id', selectedGoalId);

      applyFiltersAndRender();
    }

    function handleObjectiveChange() {
      const objectiveFilter = document.getElementById('objectiveFilter') as HTMLSelectElement;
      const strategyFilter = document.getElementById('strategyFilter') as HTMLSelectElement;
      const selectedObjectiveId = objectiveFilter?.value;

      // Update strategy dropdown based on objective
      updateCascadingDropdown(strategyFilter, 'data-objective-id', selectedObjectiveId);

      applyFiltersAndRender();
    }

    function updateCascadingDropdown(dropdown: HTMLSelectElement | null, attribute: string, value: string) {
      if (!dropdown) return;

      const options = Array.from(dropdown.options);
      options.forEach(option => {
        if (option.value === '') {
          option.style.display = 'block';
        } else {
          const attrValue = option.getAttribute(attribute);
          if (value === '' || attrValue === value) {
            option.style.display = 'block';
          } else {
            option.style.display = 'none';
          }
        }
      });

      // Reset if current selection is hidden
      const currentOption = dropdown.options[dropdown.selectedIndex];
      if (currentOption && currentOption.style.display === 'none') {
        dropdown.value = '';
      }
    }

    function applyFiltersAndRender() {
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const goalFilter = document.getElementById('goalFilter') as HTMLSelectElement;
      const objectiveFilter = document.getElementById('objectiveFilter') as HTMLSelectElement;
      const strategyFilter = document.getElementById('strategyFilter') as HTMLSelectElement;
      const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
      const yearFilter = document.getElementById('yearFilter') as HTMLSelectElement;

      const searchTerm = searchInput?.value.toLowerCase() || '';
      const selectedGoalId = goalFilter?.value || '';
      const selectedObjectiveId = objectiveFilter?.value || '';
      const selectedStrategyId = strategyFilter?.value || '';
      const selectedStatus = statusFilter?.value || '';
      const selectedYear = yearFilter?.value || '';

      // Apply filters
      filteredCommitments = allCommitments.filter(commitment => {
        // Search filter
        if (searchTerm) {
          const matchName = commitment.commitment_name?.toLowerCase().includes(searchTerm);
          const matchDetails = commitment.commitment_details?.toLowerCase().includes(searchTerm);
          const matchNumber = commitment.commitment_number?.toLowerCase().includes(searchTerm);
          if (!matchName && !matchDetails && !matchNumber) return false;
        }

        // Goal filter
        if (selectedGoalId && commitment.related_goal_id !== selectedGoalId) return false;

        // Objective filter
        if (selectedObjectiveId && commitment.related_objective_id !== selectedObjectiveId) return false;

        // Strategy filter
        if (selectedStrategyId && commitment.related_strategy_id !== selectedStrategyId) return false;

        // Status filter
        if (selectedStatus && commitment.commitment_status !== selectedStatus) return false;

        // Year filter
        if (selectedYear && commitment.completedby_year !== selectedYear) return false;

        return true;
      });

      renderTable();
    }

    function renderTable() {
      const tableBody = document.getElementById('commitmentsTableBody');
      const tableContainer = document.getElementById('commitmentsTableContainer');
      const noResults = document.getElementById('noResults');

      if (!tableBody || !tableContainer || !noResults) return;

      // Show/hide table or no results
      if (filteredCommitments.length === 0) {
        tableContainer.style.display = 'none';
        noResults.classList.remove('hidden');
        return;
      } else {
        tableContainer.style.display = 'block';
        noResults.classList.add('hidden');
      }

      // Render table rows
      tableBody.innerHTML = filteredCommitments.map(commitment => {
        const strategy = strategiesMap[commitment.related_strategy_id];
        const objective = objectivesMap[commitment.related_objective_id];
        const goal = goalsMap[commitment.related_goal_id];

        return `
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
            <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
              ${commitment.commitment_number || '-'}
            </td>
            <td class="px-6 py-4">
              <span class="line-clamp-2">${commitment.commitment_name || '-'}</span>
            </td>
            <td class="px-4 py-4 text-xs">
              ${strategy?.strategy_number || '-'}
            </td>
            <td class="px-4 py-4 text-xs">
              ${objective ? `Obj ${objective.objective_number}` : '-'}
            </td>
            <td class="px-4 py-4 text-xs">
              ${goal ? `Goal ${goal.goal_number}` : '-'}
            </td>
            <td class="px-4 py-4 text-xs">
              ${commitment.commitment_lead || '-'}
            </td>
            <td class="px-4 py-4">
              <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
                ${commitment.commitment_status || 'Not set'}
              </span>
            </td>
            <td class="px-4 py-4 text-xs whitespace-nowrap">
              ${formatCompletionDate(commitment.completedby_quarter, commitment.completedby_year)}
            </td>
            <td class="px-4 py-4">
              <a
                href="/statewide-plan/commitments/${commitment.commitment_id}"
                class="font-medium text-blue-600 dark:text-blue-500 hover:underline"
              >
                View
              </a>
            </td>
          </tr>
        `;
      }).join('');

      // Update results count
      document.getElementById('totalResults')!.textContent = filteredCommitments.length.toString();
    }

    function resetFilters() {
      (document.getElementById('searchInput') as HTMLInputElement).value = '';
      (document.getElementById('goalFilter') as HTMLSelectElement).value = '';
      (document.getElementById('objectiveFilter') as HTMLSelectElement).value = '';
      (document.getElementById('strategyFilter') as HTMLSelectElement).value = '';
      (document.getElementById('statusFilter') as HTMLSelectElement).value = '';
      (document.getElementById('yearFilter') as HTMLSelectElement).value = '';

      // Reset cascading dropdown visibility
      const objectiveFilter = document.getElementById('objectiveFilter') as HTMLSelectElement;
      const strategyFilter = document.getElementById('strategyFilter') as HTMLSelectElement;

      [objectiveFilter, strategyFilter].forEach(dropdown => {
        if (dropdown) {
          Array.from(dropdown.options).forEach(option => {
            option.style.display = 'block';
          });
        }
      });

      applyFiltersAndRender();
    }
  </script>

  <!-- Hidden data for client-side JavaScript -->
  <script id="commitmentsData" type="application/json" set:html={JSON.stringify(commitments)} />
  <script id="goalsData" type="application/json" set:html={JSON.stringify(Object.fromEntries(goals.map(g => [g.goal_id, g])))} />
  <script id="objectivesData" type="application/json" set:html={JSON.stringify(Object.fromEntries(objectives.map(o => [o.objective_id, o])))} />
  <script id="strategiesData" type="application/json" set:html={JSON.stringify(Object.fromEntries(strategies.map(s => [s.strategy_id, s])))} />
  </div>
</DashboardLayout>
