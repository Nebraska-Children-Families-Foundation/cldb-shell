---
/**
 * Action Step Detail Page
 * Shows detailed information about a single action step (NC or Community)
 */

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import HierarchyTimeline from '../../../components/statewide-plan/HierarchyTimeline.astro';
import {
  getAllActionSteps,
  getActionStepById,
  getHierarchyForActionStep,
  getNcffTeamById,
  getCommunityCollabById,
  getPreviousNextInStrategy,
  formatCompletionDate
} from '../../../utils/statewide-plan.js';

export async function getStaticPaths() {
  const actionSteps = getAllActionSteps();

  return actionSteps.map(step => ({
    params: { id: step.activity_id },
    props: { actionStep: step }
  }));
}

const { id } = Astro.params;
const actionStep = getActionStepById(id);

if (!actionStep) {
  return Astro.redirect('/404');
}

const hierarchy = getHierarchyForActionStep(id);
const { goal, objective, strategy } = hierarchy;

// Get organization name if applicable
let organizationName = null;
if (actionStep.source_type === 'NC Staff' && actionStep.ncff_team_id) {
  const team = getNcffTeamById(actionStep.ncff_team_id);
  organizationName = team ? team.team_name : null;
} else if (actionStep.source_type === 'Community Collaborative' && actionStep.related_collaborative_id) {
  const collab = getCommunityCollabById(actionStep.related_collaborative_id);
  organizationName = collab ? collab.community_collab_name : null;
}

// Get previous/next navigation
const { previous, next } = strategy ? getPreviousNextInStrategy(id, strategy.strategy_id) : { previous: null, next: null };

const pageTitle = actionStep.activity_name || 'Action Step';

// Build timeline items for hierarchy visualization
const timelineItems = [];
if (goal) {
  timelineItems.push({
    number: `Goal ${goal.goal_number}`,
    name: goal.goal_name,
    href: `/statewide-plan/goals/${goal.goal_id}`,
    color: 'blue'
  });
}
if (objective) {
  timelineItems.push({
    number: `Objective ${objective.objective_number}`,
    name: objective.objective_name,
    color: 'blue'
  });
}
if (strategy) {
  timelineItems.push({
    number: strategy.strategy_number,
    name: strategy.strategy_name,
    href: `/statewide-plan/strategies/${strategy.strategy_id}`,
    color: 'blue'
  });
}
timelineItems.push({
  number: actionStep.activity_number || 'Action Step',
  name: actionStep.activity_name || 'Unnamed Action Step',
  color: 'green'
});
---

<DashboardLayout>
  <div class="px-6 py-4">
    <!-- Breadcrumb Navigation -->
    <div class="mb-6">
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/statewide-plan" class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
              <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Statewide Plan
            </a>
          </li>
          {goal && (
            <li class="inline-flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1 dark:text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <a href={`/statewide-plan/goals/${goal.goal_id}`} class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
                Goal {goal.goal_number}
              </a>
            </li>
          )}
          {objective && (
            <li class="inline-flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1 dark:text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <a href={`/statewide-plan/goals/${goal.goal_id}`} class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
                Objective {objective.objective_number}
              </a>
            </li>
          )}
          {strategy && (
            <li class="inline-flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1 dark:text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <a href={`/statewide-plan/strategies/${strategy.strategy_id}`} class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
                Strategy {strategy.strategy_number}
              </a>
            </li>
          )}
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1 dark:text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Action Step</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div class="flex-1">
          {actionStep.activity_number && (
            <span class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-2 block">
              {actionStep.activity_number}
            </span>
          )}
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
            {actionStep.activity_name || 'Unnamed Action Step'}
          </h1>

          <!-- Badges -->
          <div class="flex flex-wrap gap-2 mb-4">
            <!-- Type Badge -->
            <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
              actionStep.source_type === 'NC Staff'
                ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300'
                : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300'
            }`}>
              {actionStep.source_type}
            </span>

            <!-- Priority Badge (NC only) -->
            {actionStep.source_type === 'NC Staff' && actionStep.activity_priority && (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">
                <svg class="w-3 h-3 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                Priority
              </span>
            )}

            <!-- Status Badge -->
            {actionStep.activity_status && (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
                {actionStep.activity_status}
              </span>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Activity Details Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <!-- Details Card -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
          Details
        </h2>
        {actionStep.activity_details ? (
          <div class="prose dark:prose-invert max-w-none">
            <p class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">
              {actionStep.activity_details}
            </p>
          </div>
        ) : (
          <p class="text-gray-500 dark:text-gray-400 italic">No details provided.</p>
        )}
      </div>

      <!-- Owner Information Card -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
          Owner Information
        </h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Lead</dt>
            <dd class="mt-1 text-sm text-gray-900 dark:text-white">
              {actionStep.activity_lead || 'Not assigned'}
            </dd>
          </div>
          {organizationName && (
            <div>
              <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">
                {actionStep.source_type === 'NC Staff' ? 'NCFF Team' : 'Community Collaborative'}
              </dt>
              <dd class="mt-1 text-sm text-gray-900 dark:text-white">
                {organizationName}
              </dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Timeline Card -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
          Timeline
        </h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Status</dt>
            <dd class="mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
                {actionStep.activity_status || 'Not set'}
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Target Completion</dt>
            <dd class="mt-1 text-sm text-gray-900 dark:text-white">
              {formatCompletionDate(actionStep.completedby_quarter, actionStep.completedby_year)}
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Hierarchy Visualization (Full Width) -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
        Hierarchy
      </h2>
      <HierarchyTimeline items={timelineItems} />
    </div>

    <!-- Navigation Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-gray-200 dark:border-gray-700">
      <!-- Previous Button -->
      <div class="w-full sm:w-auto">
        {previous ? (
          <a
            href={`/statewide-plan/action-steps/${previous.activity_id}`}
            class="inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700"
          >
            <svg class="w-3.5 h-3.5 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0 4 4M1 5l4-4"/>
            </svg>
            <span class="max-w-xs truncate">Previous: {previous.activity_name}</span>
          </a>
        ) : (
          <button
            disabled
            class="inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-lg cursor-not-allowed dark:bg-gray-700 dark:text-gray-500 dark:border-gray-600"
          >
            <svg class="w-3.5 h-3.5 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0 4 4M1 5l4-4"/>
            </svg>
            No Previous
          </button>
        )}
      </div>

      <!-- Back to Strategy / All Action Steps -->
      <div class="flex gap-2">
        {strategy && (
          <a
            href={`/statewide-plan/strategies/${strategy.strategy_id}`}
            class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700"
          >
            Back to Strategy
          </a>
        )}
        <a
          href="/statewide-plan/action-steps"
          class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700"
        >
          All Action Steps
        </a>
      </div>

      <!-- Next Button -->
      <div class="w-full sm:w-auto">
        {next ? (
          <a
            href={`/statewide-plan/action-steps/${next.activity_id}`}
            class="inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700"
          >
            <span class="max-w-xs truncate">Next: {next.activity_name}</span>
            <svg class="w-3.5 h-3.5 ml-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
            </svg>
          </a>
        ) : (
          <button
            disabled
            class="inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-lg cursor-not-allowed dark:bg-gray-700 dark:text-gray-500 dark:border-gray-600"
          >
            No Next
            <svg class="w-3.5 h-3.5 ml-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>
</DashboardLayout>
