                <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="isCollab" data-filter-value="true">Collaboratives Only</a></li>
                <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="isCollab" data-filter-value="false">Non-Collaboratives</a></li>
              </ul>
            </div>
          </div>

          <!-- Clear Filters Button -->
          <button id="clearFiltersBtn" type="button" class="text-gray-700 bg-gray-100 border border-gray-300 focus:outline-none hover:bg-gray-200 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-600 dark:text-gray-200 dark:border-gray-500 dark:hover:bg-gray-500 dark:focus:ring-gray-700 inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Clear Filters
          </button>
        </div>

        <!-- Right: View Toggles -->
        <div class="flex items-center gap-2">
          <button type="button" class="p-2 text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700" title="Card View">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 3a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5Zm0 12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H5Zm10 0a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-4Zm0-12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-4Z"/>
            </svg>
          </button>
          <button type="button" class="p-2 text-gray-900 bg-gray-100 rounded-lg dark:text-white dark:bg-gray-700" title="Table View">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M5 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5Zm1.293 3.707a1 1 0 0 1 1.414 0l2 2a1 1 0 0 1 0 1.414l-2 2a1 1 0 0 1-1.414-1.414L7.586 9.5 6.293 8.207a1 1 0 0 1 0-1.414ZM13 9a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2h-5Zm0 4a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2h-5Z" clip-rule="evenodd"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Organizations Table -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Organization Name
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Type
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Counties Served
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Phone
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Email
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Collaborative
                </th>
              </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700" id="organizationsTableBody">
              {organizationsData.map((org) => (
                <tr class="org-row hover:bg-gray-50 dark:hover:bg-gray-700" data-type={org.type} data-counties={org.counties} data-is-collab={org.isCollab}>
                  <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white">
                    {org.name}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {org.type}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
                    {org.counties}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {org.phone || ''}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {org.email ? (
                      <a href={`mailto:${org.email}`} class="text-blue-600 dark:text-blue-400 hover:underline">
                        {org.email}
                      </a>
                    ) : ''}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {org.isCollab ? (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                        Yes
                      </span>
                    ) : (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
                        No
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Stats Summary -->
      <div class="mt-4 text-sm text-gray-500 dark:text-gray-400">
        Showing <span id="orgCount">{organizationsData.length}</span> organizations
      </div>
    </div>
  </main>
</DashboardLayout>

<script>
  // Filter state
  const filters = {
    type: '',
    county: '',
    isCollab: ''
  };

  // Get all filter options
  const filterOptions = document.querySelectorAll('.filter-option');

  // Add click handlers to all filter options
  filterOptions.forEach(option => {
    option.addEventListener('click', (e) => {
      e.preventDefault();

      const filterType = option.getAttribute('data-filter-type');
      const filterValue = option.getAttribute('data-filter-value');

      // Update filter state
      filters[filterType] = filterValue;

      // Update button text
      updateButtonText(filterType, option.textContent);

      // Apply filters
      applyFilters();
    });
  });

  // Clear Filters button handler
  const clearFiltersBtn = document.getElementById('clearFiltersBtn');
  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', () => {
      // Reset all filters
      filters.type = '';
      filters.county = '';
      filters.isCollab = '';

      // Reset button texts
      document.getElementById('typeButtonText').textContent = 'Organization Type';
      document.getElementById('countyButtonText').textContent = 'County';
      document.getElementById('collabButtonText').textContent = 'Collaborative Status';

      // Apply filters (which will show all rows)
      applyFilters();
    });
  }

  function updateButtonText(filterType, text) {
    const buttonTextMap = {
      'type': 'typeButtonText',
      'county': 'countyButtonText',
      'isCollab': 'collabButtonText'
    };

    const buttonTextElement = document.getElementById(buttonTextMap[filterType]);
    if (buttonTextElement) {
      buttonTextElement.textContent = text.trim();
    }
  }

  function applyFilters() {
    const rows = document.querySelectorAll('.org-row');
    let visibleCount = 0;

    rows.forEach(row => {
      let shouldShow = true;

      // Check type filter
      if (filters.type && row.getAttribute('data-type') !== filters.type) {
        shouldShow = false;
      }

      // Check county filter - handle multiple counties
      if (filters.county) {
        const rowCounties = row.getAttribute('data-counties');
        if (!rowCounties.includes(filters.county)) {
          shouldShow = false;
        }
      }

      // Check collaborative filter
      if (filters.isCollab) {
        const rowIsCollab = row.getAttribute('data-is-collab');
        if (rowIsCollab !== filters.isCollab) {
          shouldShow = false;
        }
      }

      // Show or hide row
      if (shouldShow) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    // Update count
    const countElement = document.getElementById('orgCount');
    if (countElement) {
      countElement.textContent = visibleCount.toString();
    }
  }
</script>
