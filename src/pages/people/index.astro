const counties = [...new Set(peopleData.flatMap(p => p.county.split(', ')))].sort();
const collaboratives = [...new Set(peopleData.map(p => p.collaborative))].sort();
---

<DashboardLayout>
  <main>
    <div class="p-4">
      <!-- Command Bar with Filters and Views -->
      <div class="mb-4 flex items-center justify-between bg-white dark:bg-gray-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
        <!-- Left: Filters -->
        <div class="flex items-center gap-4">
          <!-- Role Filter -->
          <div>
            <button id="roleDropdownButton" data-dropdown-toggle="roleDropdown" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700 inline-flex items-center" type="button">
              <span id="roleButtonText">Role</span>
              <svg class="w-2.5 h-2.5 ms-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
              </svg>
            </button>
            <!-- Dropdown menu -->
            <div id="roleDropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44 dark:bg-gray-700">
              <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="roleDropdownButton">
                <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="role" data-filter-value="">All Roles</a></li>
                {roles.map(role => (
                  <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="role" data-filter-value={role}>{role}</a></li>
                ))}
              </ul>
            </div>
          </div>

          <!-- County Filter -->
          <div>
            <button id="countyDropdownButton" data-dropdown-toggle="countyDropdown" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700 inline-flex items-center" type="button">
              <span id="countyButtonText">County</span>
              <svg class="w-2.5 h-2.5 ms-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
              </svg>
            </button>
            <!-- Dropdown menu -->
            <div id="countyDropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44 dark:bg-gray-700 max-h-60 overflow-y-auto">
              <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="countyDropdownButton">
                <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="county" data-filter-value="">All Counties</a></li>
                {counties.map(county => (
                  <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="county" data-filter-value={county}>{county}</a></li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Collaborative Filter -->
          <div>
            <button id="collaborativeDropdownButton" data-dropdown-toggle="collaborativeDropdown" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700 inline-flex items-center" type="button">
              <span id="collaborativeButtonText">Collaborative</span>
              <svg class="w-2.5 h-2.5 ms-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
              </svg>
            </button>
            <!-- Dropdown menu -->
            <div id="collaborativeDropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-64 dark:bg-gray-700 max-h-60 overflow-y-auto">
              <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="collaborativeDropdownButton">
                <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="collaborative" data-filter-value="">All Collaboratives</a></li>
                {collaboratives.map(collab => (
                  <li><a href="#" class="filter-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" data-filter-type="collaborative" data-filter-value={collab}>{collab}</a></li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Clear Filters Button -->
          <button id="clearFiltersBtn" type="button" class="text-gray-700 bg-gray-100 border border-gray-300 focus:outline-none hover:bg-gray-200 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-600 dark:text-gray-200 dark:border-gray-500 dark:hover:bg-gray-500 dark:focus:ring-gray-700 inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Clear Filters
          </button>
        </div>

        <!-- Right: View Toggles -->
        <div class="flex items-center gap-2">
          <button type="button" class="p-2 text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700" title="Card View">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 3a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5Zm0 12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H5Zm10 0a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-4Zm0-12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-4Z"/>
            </svg>
          </button>
          <button type="button" class="p-2 text-gray-900 bg-gray-100 rounded-lg dark:text-white dark:bg-gray-700" title="Table View">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M5 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5Zm1.293 3.707a1 1 0 0 1 1.414 0l2 2a1 1 0 0 1 0 1.414l-2 2a1 1 0 0 1-1.414-1.414L7.586 9.5 6.293 8.207a1 1 0 0 1 0-1.414ZM13 9a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2h-5Zm0 4a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2h-5Z" clip-rule="evenodd"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- People Table -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Name
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Role
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Phone
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Email
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  Collaborative
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                  County
                </th>
              </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700" id="peopleTableBody">
              {peopleData.map((person) => (
                <tr class="person-row hover:bg-gray-50 dark:hover:bg-gray-700" data-role={person.role} data-county={person.county} data-collaborative={person.collaborative}>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
                    {person.name}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {person.role}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {person.phone || '—'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                    {person.email ? (
                      <a href={`mailto:${person.email}`} class="text-blue-600 dark:text-blue-400 hover:underline">
                        {person.email}
                      </a>
                    ) : '—'}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
                    {person.collaborative}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
                    {person.county}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Stats Summary -->
      <div class="mt-4 text-sm text-gray-500 dark:text-gray-400">
        Showing <span id="peopleCount">{peopleData.length}</span> people
      </div>
    </div>
  </main>
</DashboardLayout>

<script>
  // Filter state
  const filters = {
    role: '',
    county: '',
    collaborative: ''
  };

  // Get all filter options
  const filterOptions = document.querySelectorAll('.filter-option');

  // Add click handlers to all filter options
  filterOptions.forEach(option => {
    option.addEventListener('click', (e) => {
      e.preventDefault();

      const filterType = option.getAttribute('data-filter-type');
      const filterValue = option.getAttribute('data-filter-value');

      // Update filter state
      filters[filterType] = filterValue;

      // Update button text
      updateButtonText(filterType, option.textContent);

      // Apply filters
      applyFilters();
    });
  });

  // Clear Filters button handler
  const clearFiltersBtn = document.getElementById('clearFiltersBtn');
  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', () => {
      // Reset all filters
      filters.role = '';
      filters.county = '';
      filters.collaborative = '';

      // Reset button texts
      document.getElementById('roleButtonText').textContent = 'Role';
      document.getElementById('countyButtonText').textContent = 'County';
      document.getElementById('collaborativeButtonText').textContent = 'Collaborative';

      // Apply filters (which will show all rows)
      applyFilters();
    });
  }

  function updateButtonText(filterType, text) {
    const buttonTextMap = {
      'role': 'roleButtonText',
      'county': 'countyButtonText',
      'collaborative': 'collaborativeButtonText'
    };

    const buttonTextElement = document.getElementById(buttonTextMap[filterType]);
    if (buttonTextElement) {
      buttonTextElement.textContent = text.trim();
    }
  }

  function applyFilters() {
    const rows = document.querySelectorAll('.person-row');
    let visibleCount = 0;

    rows.forEach(row => {
      let shouldShow = true;

      // Check role filter
      if (filters.role && row.getAttribute('data-role') !== filters.role) {
        shouldShow = false;
      }

      // Check county filter - handle multiple counties
      if (filters.county) {
        const rowCounties = row.getAttribute('data-county');
        if (!rowCounties.includes(filters.county)) {
          shouldShow = false;
        }
      }

      // Check collaborative filter
      if (filters.collaborative && row.getAttribute('data-collaborative') !== filters.collaborative) {
        shouldShow = false;
      }

      // Show or hide row
      if (shouldShow) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    // Update count
    const countElement = document.getElementById('peopleCount');
    if (countElement) {
      countElement.textContent = visibleCount.toString();
    }
  }
</script>
