  <!-- JavaScript for form interactivity -->
  <script>
    // Enable fields when "Change" buttons are clicked
    document.addEventListener('DOMContentLoaded', function() {
      // School District change button
      document.getElementById('change-district').addEventListener('click', function() {
        const districtSelect = document.getElementById('school-district');
        districtSelect.disabled = false;
        districtSelect.classList.remove('bg-gray-100');
        districtSelect.classList.add('bg-gray-50');
        districtSelect.focus();
      });

      // License Type change button
      document.getElementById('change-license-type').addEventListener('click', function() {
        const licenseTypeSelect = document.getElementById('license-type');
        licenseTypeSelect.disabled = false;
        licenseTypeSelect.classList.remove('bg-gray-100');
        licenseTypeSelect.classList.add('bg-gray-50');
        licenseTypeSelect.focus();
      });

      // Add teacher button
      let teacherCount = 1;
      document.getElementById('add-teacher').addEventListener('click', function() {
        teacherCount++;
        const teachersContainer = document.getElementById('teachers-container');
        const teacherRow = document.createElement('div');
        teacherRow.className = 'flex flex-wrap gap-4 mb-3 teacher-row';
        teacherRow.innerHTML = `
          <div>
            <label for="teacher-first-${teacherCount}" class="block mb-1 text-xs text-gray-600 dark:text-gray-400">First Name</label>
            <input type="text" id="teacher-first-${teacherCount}" 
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
          </div>
          <div>
            <label for="teacher-last-${teacherCount}" class="block mb-1 text-xs text-gray-600 dark:text-gray-400">Last Name</label>
            <input type="text" id="teacher-last-${teacherCount}" 
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
          </div>
          <div class="flex items-end pb-3">
            <div class="flex items-center">
              <input id="new-teacher-${teacherCount}" type="checkbox" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600">
              <label for="new-teacher-${teacherCount}" class="ml-2 text-sm text-gray-900 dark:text-white">New Teacher</label>
            </div>
          </div>
        `;
        teachersContainer.appendChild(teacherRow);
      });

      // DHHS status "Other" option handling
      document.getElementById('dhhs-status').addEventListener('change', function() {
        const otherDescription = document.getElementById('other-description');
        if (this.value === 'Other') {
          otherDescription.classList.remove('hidden');
        } else {
          otherDescription.classList.add('hidden');
        }
      });

      // Step Up Quality Coach "Yes" option handling
      document.getElementById('step-up-coach').addEventListener('change', function() {
        const coachNameField = document.getElementById('step-up-coach-name');
        if (this.value === 'Yes') {
          coachNameField.classList.remove('hidden');
        } else {
          coachNameField.classList.add('hidden');
        }
      });

      // Rooted Coach "Yes" option handling
      document.getElementById('rooted-coach').addEventListener('change', function() {
        const rootedNameField = document.getElementById('rooted-coach-name');
        if (this.value === 'Yes') {
          rootedNameField.classList.remove('hidden');
        } else {
          rootedNameField.classList.add('hidden');
        }
      });

      // Modal handling for Step Up Coach
      document.getElementById('modal-step-up-coach').addEventListener('change', function() {
        const coachNameContainer = document.getElementById('modal-step-coach-name-container');
        if (this.value === 'Yes') {
          coachNameContainer.classList.remove('hidden');
        } else {
          coachNameContainer.classList.add('hidden');
        }
      });

      // Modal handling for Rooted Coach
      document.getElementById('modal-rooted-coach').addEventListener('change', function() {
        const rootedNameContainer = document.getElementById('modal-rooted-name-container');
        if (this.value === 'Yes') {
          rootedNameContainer.classList.remove('hidden');
        } else {
          rootedNameContainer.classList.add('hidden');
        }
      });
    });
  </script>
