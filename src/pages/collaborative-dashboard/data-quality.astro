---
// src/pages/collaborative-dashboard/data-quality.astro
import CollaborativeDashboard from "../../layouts/CollaborativeDashboard.astro";
---

<CollaborativeDashboard title="Data Quality | Community Lens Database" activeSubnavItem="Data Quality">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Data Quality Dashboard</h1>

    <!-- Overall Quality Score -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Overall Data Quality Score</h2>

      <div class="flex items-center justify-center">
        <div class="text-center">
          <div class="text-6xl font-bold text-green-600 dark:text-green-400">87%</div>
          <p class="text-gray-600 dark:text-gray-400 mt-2">Overall Quality</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <p class="text-sm text-gray-500 dark:text-gray-400">Completeness</p>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">92%</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <p class="text-sm text-gray-500 dark:text-gray-400">Accuracy</p>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">85%</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <p class="text-sm text-gray-500 dark:text-gray-400">Consistency</p>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">89%</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <p class="text-sm text-gray-500 dark:text-gray-400">Timeliness</p>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">83%</p>
        </div>
      </div>
    </div>

    <!-- Data Issues -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Data Quality Issues</h2>
        <span class="px-3 py-1 bg-red-100 text-red-800 text-sm font-medium rounded-full dark:bg-red-900 dark:text-red-300">
          12 Issues Found
        </span>
      </div>

      <div class="overflow-x-auto relative">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
              <th scope="col" class="py-3 px-6">Issue Type</th>
              <th scope="col" class="py-3 px-6">Record Type</th>
              <th scope="col" class="py-3 px-6">Severity</th>
              <th scope="col" class="py-3 px-6">Count</th>
              <th scope="col" class="py-3 px-6">Last Detected</th>
              <th scope="col" class="py-3 px-6">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">Missing Email</td>
              <td class="py-4 px-6">People</td>
              <td class="py-4 px-6">
                <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">
                  Medium
                </span>
              </td>
              <td class="py-4 px-6">23</td>
              <td class="py-4 px-6">Oct 25, 2025</td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Review</a>
              </td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">Duplicate Records</td>
              <td class="py-4 px-6">Organizations</td>
              <td class="py-4 px-6">
                <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">
                  High
                </span>
              </td>
              <td class="py-4 px-6">7</td>
              <td class="py-4 px-6">Oct 24, 2025</td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Review</a>
              </td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">Invalid Phone Format</td>
              <td class="py-4 px-6">People</td>
              <td class="py-4 px-6">
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">
                  Low
                </span>
              </td>
              <td class="py-4 px-6">15</td>
              <td class="py-4 px-6">Oct 23, 2025</td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Review</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Data Quality Trends & Validation Rules -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Trends -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Quality Trends</h2>

        <div class="space-y-4">
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Last Month</span>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">85%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
              <div class="bg-blue-600 h-2.5 rounded-full" style="width: 85%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">This Month</span>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">87%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
              <div class="bg-green-600 h-2.5 rounded-full" style="width: 87%"></div>
            </div>
          </div>

          <div class="mt-4 p-4 bg-green-50 dark:bg-green-900/20 rounded-lg">
            <p class="text-sm text-green-800 dark:text-green-300">
              <span class="font-semibold">Improvement:</span> Data quality has improved by 2% this month
            </p>
          </div>
        </div>
      </div>

      <!-- Validation Rules -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Active Validation Rules</h2>

        <div class="space-y-3">
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg dark:bg-gray-700">
            <span class="text-sm text-gray-900 dark:text-white">Required Fields Check</span>
            <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded dark:bg-green-900 dark:text-green-300">Active</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg dark:bg-gray-700">
            <span class="text-sm text-gray-900 dark:text-white">Email Format Validation</span>
            <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded dark:bg-green-900 dark:text-green-300">Active</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg dark:bg-gray-700">
            <span class="text-sm text-gray-900 dark:text-white">Duplicate Detection</span>
            <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded dark:bg-green-900 dark:text-green-300">Active</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg dark:bg-gray-700">
            <span class="text-sm text-gray-900 dark:text-white">Data Consistency Check</span>
            <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded dark:bg-green-900 dark:text-green-300">Active</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</CollaborativeDashboard>
