---
// src/pages/collaborative-dashboard/referrals.astro
import CollaborativeDashboard from "../../layouts/CollaborativeDashboard.astro";
---

<CollaborativeDashboard title="Referrals | Community Lens Database" activeSubnavItem="Referrals">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Status of Referrals to Partners</h1>

    <!-- Referral Status Overview -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Referral Status by Category -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Referral Status by Category</h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Not Updated</span>
            <span class="font-semibold text-gray-900 dark:text-white">59.6%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Got Help</span>
            <span class="font-semibold text-gray-900 dark:text-white">26.2%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Pending</span>
            <span class="font-semibold text-gray-900 dark:text-white">2.7%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Needs Client Action</span>
            <span class="font-semibold text-gray-900 dark:text-white">2.7%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Eligible</span>
            <span class="font-semibold text-gray-900 dark:text-white">2.6%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Other</span>
            <span class="font-semibold text-gray-900 dark:text-white">6.1%</span>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
          <p class="text-center text-lg font-semibold text-gray-700 dark:text-gray-300">Total: 11,345</p>
        </div>
      </div>

      <!-- How long since referral entered "Not Updated" status -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Time in "Not Updated" Status</h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">90+ days</span>
            <span class="font-semibold text-red-600 dark:text-red-400">81.9%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">30+ days</span>
            <span class="font-semibold text-orange-600 dark:text-orange-400">7.1%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">60+ days</span>
            <span class="font-semibold text-yellow-600 dark:text-yellow-400">6.6%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Other</span>
            <span class="font-semibold text-gray-900 dark:text-white">4.4%</span>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
          <p class="text-center text-lg font-semibold text-gray-700 dark:text-gray-300">Total: 6,764</p>
        </div>
      </div>
    </div>

    <!-- Closing The Loop -->
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Closing The Loop</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Closed vs. In Progress Status -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
          <h3 class="text-md font-semibold text-gray-800 dark:text-white mb-3">Closed vs. In Progress Status</h3>
          <div class="space-y-3">
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-sm text-gray-600 dark:text-gray-400">In Progress</span>
                <span class="text-sm font-semibold text-gray-900 dark:text-white">67.7%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3 dark:bg-gray-700">
                <div class="bg-green-600 h-3 rounded-full" style="width: 67.7%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-sm text-gray-600 dark:text-gray-400">Closed Loop</span>
                <span class="text-sm font-semibold text-gray-900 dark:text-white">32.3%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3 dark:bg-gray-700">
                <div class="bg-blue-600 h-3 rounded-full" style="width: 32.3%"></div>
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700">
            <p class="text-center text-sm font-semibold text-gray-700 dark:text-gray-300">Total: 11,345</p>
          </div>
        </div>

        <!-- Days to Close the Loop -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
          <h3 class="text-md font-semibold text-gray-800 dark:text-white mb-3">Days to Close the Loop</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">0 - 7 days</span>
              <span class="font-semibold text-gray-900 dark:text-white">77.8%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">8 - 14 days</span>
              <span class="font-semibold text-gray-900 dark:text-white">6.8%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">30+ days</span>
              <span class="font-semibold text-gray-900 dark:text-white">4.6%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">90+ days</span>
              <span class="font-semibold text-gray-900 dark:text-white">3.9%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">60+ days</span>
              <span class="font-semibold text-gray-900 dark:text-white">2.5%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">Other</span>
              <span class="font-semibold text-gray-900 dark:text-white">4.3%</span>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700">
            <p class="text-center text-sm font-semibold text-gray-700 dark:text-gray-300">Total: 3,667</p>
          </div>
        </div>

        <!-- Received Help vs. Did Not -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
          <h3 class="text-md font-semibold text-gray-800 dark:text-white mb-3">Received Help vs. Did Not</h3>
          <div class="space-y-3">
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-sm text-gray-600 dark:text-gray-400">Got Help</span>
                <span class="text-sm font-semibold text-gray-900 dark:text-white">84.2%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3 dark:bg-gray-700">
                <div class="bg-green-600 h-3 rounded-full" style="width: 84.2%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-sm text-gray-600 dark:text-gray-400">Didn't Get Help</span>
                <span class="text-sm font-semibold text-gray-900 dark:text-white">15.8%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3 dark:bg-gray-700">
                <div class="bg-red-600 h-3 rounded-full" style="width: 15.8%"></div>
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700">
            <p class="text-center text-sm font-semibold text-gray-700 dark:text-gray-300">Total: 3,667</p>
          </div>
        </div>

        <!-- Reason for Not Getting Help -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
          <h3 class="text-md font-semibold text-gray-800 dark:text-white mb-3">Reason for Not Getting Help</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">No Longer Interested</span>
              <span class="font-semibold text-gray-900 dark:text-white">32.0%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">Couldn't Get Help</span>
              <span class="font-semibold text-gray-900 dark:text-white">29.4%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">Not Eligible</span>
              <span class="font-semibold text-gray-900 dark:text-white">18.8%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">Couldn't Contact</span>
              <span class="font-semibold text-gray-900 dark:text-white">14.9%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 dark:text-gray-400">No Capacity</span>
              <span class="font-semibold text-gray-900 dark:text-white">5.0%</span>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700">
            <p class="text-center text-sm font-semibold text-gray-700 dark:text-gray-300">Total: 579</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Summary Note -->
    <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800 dark:text-blue-300">Note about Referral Data</h3>
          <div class="mt-2 text-sm text-blue-700 dark:text-blue-400">
            <p>Categories and Service Tags are set by the agency providing the program or service or inferred by Findhelp. This taxonomy may not accurately reflect what the program/service does. Referrals can have multiple categories and service tags.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</CollaborativeDashboard>
