---
// src/pages/collaborative-dashboard/referrals.astro
import CollaborativeDashboard from "../../layouts/CollaborativeDashboard.astro";
---

<CollaborativeDashboard title="Referrals | Community Lens Database" activeSubnavItem="Referrals">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Referral Management</h1>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
      <!-- Referral Stats -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Pending</p>
        <p class="text-2xl font-semibold text-yellow-600 dark:text-yellow-400">34</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">In Progress</p>
        <p class="text-2xl font-semibold text-blue-600 dark:text-blue-400">87</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Completed</p>
        <p class="text-2xl font-semibold text-green-600 dark:text-green-400">456</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">This Month</p>
        <p class="text-2xl font-semibold text-gray-900 dark:text-white">123</p>
      </div>
    </div>

    <!-- Recent Referrals -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Recent Referrals</h2>
        <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          New Referral
        </button>
      </div>

      <div class="overflow-x-auto relative">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
              <th scope="col" class="py-3 px-6">Referral ID</th>
              <th scope="col" class="py-3 px-6">Client Name</th>
              <th scope="col" class="py-3 px-6">Service Type</th>
              <th scope="col" class="py-3 px-6">Referred To</th>
              <th scope="col" class="py-3 px-6">Date</th>
              <th scope="col" class="py-3 px-6">Status</th>
              <th scope="col" class="py-3 px-6">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">REF-2025-1247</td>
              <td class="py-4 px-6">John Doe</td>
              <td class="py-4 px-6">Mental Health</td>
              <td class="py-4 px-6">Community Counseling</td>
              <td class="py-4 px-6">Oct 25, 2025</td>
              <td class="py-4 px-6">
                <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">
                  Pending
                </span>
              </td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">View</a>
              </td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">REF-2025-1246</td>
              <td class="py-4 px-6">Jane Smith</td>
              <td class="py-4 px-6">Housing Assistance</td>
              <td class="py-4 px-6">Housing Authority</td>
              <td class="py-4 px-6">Oct 24, 2025</td>
              <td class="py-4 px-6">
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                  In Progress
                </span>
              </td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">View</a>
              </td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">REF-2025-1245</td>
              <td class="py-4 px-6">Michael Johnson</td>
              <td class="py-4 px-6">Food Assistance</td>
              <td class="py-4 px-6">Food Bank Network</td>
              <td class="py-4 px-6">Oct 23, 2025</td>
              <td class="py-4 px-6">
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">
                  Completed
                </span>
              </td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">View</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Referral Sources -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Top Referral Sources</h2>

      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Community Health Centers</span>
          <span class="font-semibold text-gray-900 dark:text-white">156 referrals</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">School Districts</span>
          <span class="font-semibold text-gray-900 dark:text-white">134 referrals</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Social Services</span>
          <span class="font-semibold text-gray-900 dark:text-white">98 referrals</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Faith-Based Organizations</span>
          <span class="font-semibold text-gray-900 dark:text-white">67 referrals</span>
        </div>
      </div>
    </div>
  </div>
</CollaborativeDashboard>
