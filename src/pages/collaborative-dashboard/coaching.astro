---
// src/pages/collaborative-dashboard/coaching.astro
import CollaborativeDashboard from "../../layouts/CollaborativeDashboard.astro";
---

<CollaborativeDashboard title="Coaching | Community Lens Database" activeSubnavItem="Coaching">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Coaching Programs</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Coaching Stats -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Active Coaching Sessions</h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Individual Sessions</span>
            <span class="font-semibold text-gray-900 dark:text-white">42</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Group Sessions</span>
            <span class="font-semibold text-gray-900 dark:text-white">18</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Total Participants</span>
            <span class="font-semibold text-gray-900 dark:text-white">127</span>
          </div>
        </div>
      </div>

      <!-- Program Outcomes -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Program Outcomes</h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Completion Rate</span>
            <span class="font-semibold text-green-600 dark:text-green-400">92%</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Average Duration</span>
            <span class="font-semibold text-gray-900 dark:text-white">6 months</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600 dark:text-gray-400">Follow-up Rate</span>
            <span class="font-semibold text-blue-600 dark:text-blue-400">85%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Upcoming Sessions -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Upcoming Sessions</h2>

      <div class="overflow-x-auto relative">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
              <th scope="col" class="py-3 px-6">Date</th>
              <th scope="col" class="py-3 px-6">Time</th>
              <th scope="col" class="py-3 px-6">Coach</th>
              <th scope="col" class="py-3 px-6">Type</th>
              <th scope="col" class="py-3 px-6">Participants</th>
              <th scope="col" class="py-3 px-6">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">Oct 26, 2025</td>
              <td class="py-4 px-6">10:00 AM</td>
              <td class="py-4 px-6">Dr. Lisa Martinez</td>
              <td class="py-4 px-6">Group</td>
              <td class="py-4 px-6">8</td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">View</a>
              </td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">Oct 27, 2025</td>
              <td class="py-4 px-6">2:00 PM</td>
              <td class="py-4 px-6">James Wilson</td>
              <td class="py-4 px-6">Individual</td>
              <td class="py-4 px-6">1</td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">View</a>
              </td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="py-4 px-6">Oct 28, 2025</td>
              <td class="py-4 px-6">9:00 AM</td>
              <td class="py-4 px-6">Dr. Lisa Martinez</td>
              <td class="py-4 px-6">Group</td>
              <td class="py-4 px-6">12</td>
              <td class="py-4 px-6">
                <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">View</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Quick Actions</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="#" class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all">
          <svg class="w-8 h-8 text-gray-500 dark:text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-900 dark:text-white">Schedule Session</span>
        </a>

        <a href="#" class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all">
          <svg class="w-8 h-8 text-gray-500 dark:text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-900 dark:text-white">View Reports</span>
        </a>

        <a href="#" class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all">
          <svg class="w-8 h-8 text-gray-500 dark:text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-900 dark:text-white">Manage Coaches</span>
        </a>
      </div>
    </div>
  </div>
</CollaborativeDashboard>
