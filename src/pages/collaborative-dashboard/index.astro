---
// src/pages/collaborative-dashboard/index.astro
import CollaborativeDashboard from "../../layouts/CollaborativeDashboard.astro";
---

<CollaborativeDashboard title="Collaborative Dashboard - Overview | Community Lens Database" activeSubnavItem="Overview">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Community Insights Dashboard - Statewide Dashboard</h1>

  <!-- Central Navigation Metrics -->
  <div class="mb-6">
    <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Number of Referrals/Services Provided for Central Navigation</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-4xl font-bold text-gray-900 dark:text-white mb-2">6,883</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Intakes: Total Central Navigation Intakes</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-4xl font-bold text-gray-900 dark:text-white mb-2">20,039</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Referrals: Total Number of Referrals Made</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-4xl font-bold text-gray-900 dark:text-white mb-2">6,479</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Referrals: Individual Help-Seekers Referred</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-4xl font-bold text-gray-900 dark:text-white mb-2">10,048</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Support: Number of Children Served</p>
      </div>
    </div>
  </div>

    <!-- Coaching Metrics -->
    <div class="mb-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Number of Referrals/Services Provided for Coaching</h2>
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <p class="text-5xl font-bold text-gray-900 dark:text-white mb-2">2,222</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Number of Referrals/Services provided for Coaching</p>
      </div>
    </div>

    <!-- Stabilization Funding -->
    <div class="mb-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Stabilization Funding</h2>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-4">
        <p class="text-5xl font-bold text-green-600 dark:text-green-400 mb-2">$1,183,421.95</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Support Stabilization Funds distributed</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
          <p class="text-4xl font-bold text-gray-900 dark:text-white mb-2">2,036</p>
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Individuals who received stabilization support funding</p>
        </div>

        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
          <p class="text-4xl font-bold text-gray-900 dark:text-white mb-2">3,251</p>
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Number of stabilization support fund requests submitted by help-seekers</p>
        </div>
      </div>
    </div>

    <!-- Help-Seekers by Category -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Number of help-seekers receiving assistance by category</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <!-- Housing -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">916</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Housing</p>
        </div>

        <!-- Utilities -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">682</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Utilities</p>
        </div>

        <!-- Transportation -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">246</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Transportation</p>
        </div>

        <!-- Daily Living -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">168</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Daily Living</p>
        </div>

        <!-- Mental Health -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">75</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Mental Health</p>
        </div>

        <!-- Parenting -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">76</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Parenting</p>
        </div>

        <!-- Education -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">62</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Education</p>
        </div>

        <!-- Coaching -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">45</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Coaching</p>
        </div>

        <!-- Employment -->
        <div class="text-center p-4 bg-gray-50 rounded-lg dark:bg-gray-700 transition-all hover:shadow-md">
          <svg class="w-8 h-8 mx-auto mb-2" style="color: #9fcd74;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <p class="text-2xl font-semibold text-gray-900 dark:text-white">12</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Employment</p>
        </div>
      </div>
    </div>

    <!-- Additional Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3">Family Presentations with Identified Needs</h3>
        <p class="text-5xl font-bold text-blue-600 dark:text-blue-400 mb-2">25,165</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Times a family presents with an identified need</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3">Family Self-Reporting Improvements</h3>
        <p class="text-5xl font-bold text-purple-600 dark:text-purple-400 mb-2">62</p>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Number of help-seekers who reported an improvement in their promotive/protective factors</p>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Quick Links</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/collaborative-dashboard/central-navigation" class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all">
          <svg class="w-8 h-8 text-gray-500 dark:text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M11.906 1.994a8.002 8.002 0 018.09 8.421 7.996 7.996 0 01-1.297 3.957.996.996 0 01-.133.204l-.108.129c-.178.243-.37.477-.573.699l-5.112 6.224a1 1 0 01-1.545 0L5.982 15.26l-.002-.002a18.146 18.146 0 01-.309-.38l-.133-.163a.999.999 0 01-.13-.202 7.995 7.995 0 016.498-12.518zM15 9.997a3 3 0 11-5.999 0 3 3 0 015.999 0z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-900 dark:text-white">Central Navigation</span>
        </a>

        <a href="/collaborative-dashboard/coaching" class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all">
          <svg class="w-8 h-8 text-gray-500 dark:text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
          </svg>
          <span class="text-gray-900 dark:text-white">Coaching</span>
        </a>

        <a href="/collaborative-dashboard/referrals" class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all">
          <svg class="w-8 h-8 text-gray-500 dark:text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 5a1 1 0 100 2h5.586l-1.293 1.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L13.586 5H8zM12 15a1 1 0 100-2H6.414l1.293-1.293a1 1 0 10-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L6.414 15H12z"></path>
          </svg>
          <span class="text-gray-900 dark:text-white">Referrals</span>
        </a>
      </div>
    </div>
</CollaborativeDashboard>
