---

<DashboardLayout>
  <main>
    <div class="p-4">

      <!-- Map Component with position adjustments -->
      <div class="w-full h-[600px] bg-gray-900 border border-gray-700 rounded-lg overflow-hidden relative z-10">
        <LeafletMap client:only="vue" locations={locationData} />
      </div>

      <!-- Collaboratives Cards -->
      <div class="mt-4 p-6 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Community Collaboratives</h3>
          <span class="text-sm text-gray-500 dark:text-gray-400">{locationData.length} collaboratives</span>
        </div>

        <!-- Card Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

          <!-- Better Together Collaborative -->
          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 hover:shadow-lg transition-shadow">
            <div class="flex justify-between items-start mb-3">
              <h4 class="text-lg font-semibold text-gray-900 dark:text-white">Better Together Collaborative</h4>
            </div>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Otoe
              </span>
            </div>
            <div class="space-y-3 text-sm">
              <div class="flex items-start">
                <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-medium text-gray-900 dark:text-white">Coordinator</p>
                  <p class="text-gray-700 dark:text-gray-300">Lisa Chaney</p>
                  <a href="tel:402-713-5270" class="text-blue-600 dark:text-blue-400 hover:underline">402-713-5270</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Bridge Family Resource Connector Network -->
