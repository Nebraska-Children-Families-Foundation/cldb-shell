---

<DashboardLayout>
  <main>
    <div class="p-4">

      <!-- Map Component with position adjustments -->
      <div class="w-full h-[600px] bg-gray-900 border border-gray-700 rounded-lg overflow-hidden relative z-10">
        <LeafletMap client:only="vue" locations={locationData} />
      </div>

      <!-- Collaboratives Table -->
      <div class="mt-4 p-4 bg-gray-900 border border-gray-700 rounded-lg">
        <h3 class="text-lg font-semibold mb-2 text-white">Community Collaboratives</h3>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-700">
            <thead>
              <tr>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-300">Collaborative</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-300">City</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
              {locationData.map((location) => (
                <tr>
                  <td class="px-4 py-2 text-sm text-white">{location.name}</td>
                  <td class="px-4 py-2 text-sm text-white">{location.address}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</DashboardLayout>