<!-- JavaScript to handle active state toggle using Tailwind classes -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navItems = document.querySelectorAll('.container ul li a');
    
    navItems.forEach(item => {
      item.addEventListener('click', function(e) {
        // Remove active classes from all items
        navItems.forEach(navItem => {
          navItem.classList.remove('border-lime-500', 'text-lime-500');
          navItem.classList.add('border-transparent');
        });
        
        // Add active classes to clicked item
        this.classList.remove('border-transparent');
        this.classList.add('border-lime-500', 'text-lime-500');
      });
    });
  });
</script>