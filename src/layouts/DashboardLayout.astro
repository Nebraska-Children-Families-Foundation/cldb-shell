			<MainNavbar />
			<MapSidebar />

			<!-- #######  Bring in the Components ####### -->
			<div class="flex">
				<div class="w-64 flex-none"></div><!-- creates space for the sidebar -->
				<div class="flex-auto">
					<slot />
				</div>
			</div>
		</div>
	<!-- Flowbite JS -->
	<script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>
