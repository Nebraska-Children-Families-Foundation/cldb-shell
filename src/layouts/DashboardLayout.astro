---
import DarkModeToggle from "../components/DarkModeToggle.astro";
import MainNavbar from "../components/MainNavbar.astro";
import MapSidebar from "../components/MapSidebar.astro";
---

<!doctype html>
<html lang="en">
    <head>
       <meta charset="UTF-8" />
       <meta name="viewport" content="width=device-width" />
       <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
       <meta name="generator" content={Astro.generator} />

       <!-- Theme initialization script - must run before page renders -->
       <script is:inline>
          // Immediately set theme to prevent FOUC (Flash of Unstyled Content)
          (function() {
             const storedTheme = localStorage.getItem("theme");
             const prefersDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;

             if (storedTheme === "dark" || (!storedTheme && prefersDarkMode)) {
                document.documentElement.classList.add("dark");
             }
          })();
       </script>

       <!-- Leaflet CSS -->
       <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
             integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
             crossorigin=""/>

       <!-- Flowbite -->
       <link href="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.css" rel="stylesheet" />

       <title>Community Lens Database</title>
    </head>
    <body>
       <div class="antialiased bg-gray-50 dark:bg-gray-900" style="min-height: 100vh;">
          <!-- Fixed position navbar with high z-index -->
          <div class="fixed top-0 left-0 right-0 z-50">
             <MainNavbar />
          </div>

          <!-- Sidebar with appropriate positioning -->
          <div class="fixed top-16 left-0 bottom-0 z-40">
             <MapSidebar />
          </div>

          <!-- Component Container with padding to account for navbar -->
          <div class="flex pt-16"> <!-- 16 = 4rem = ~64px navbar height -->
             <div class="w-64 hidden md:block flex-none"></div><!-- creates space for the sidebar -->
             <div class="flex-auto">
                <slot />
             </div>
          </div>
       </div>

       <!-- Flowbite JS -->
       <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>
    </body>
</html>